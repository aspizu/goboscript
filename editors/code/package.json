{
  "name": "goboscript",
  "displayName": "goboscript",
  "version": "2.0.0",
  "description": "goboscript language support for Visual Studio Code.",
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "goboscript"
  ],
  "homepage": "https://github.com/aspizu/goboscript",
  "license": "MIT",
  "author": {
    "name": "Priyanshu Dangare",
    "email": "hi@aspiz.uk",
    "url": "https://aspiz.uk"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aspizu/goboscript.git"
  },
  "publisher": "aspizu",
  "dependencies": {
    "@turbowarp/scaffolding": "0.4.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:goboscript",
    "onCustomEditor:goboscript.sb3Preview"
  ],
  "scripts": {
    "compile": "node esbuild.ts",
    "watch": "node esbuild.ts --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.webview.json",
    "package": "pnpm run compile && vsce package --no-dependencies -o goboscript.vsix"
  },
  "devDependencies": {
    "@turbowarp/types": "0.0.15",
    "@types/node": "^24.19.0",
    "@types/vscode": "^1.138.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "contributes": {
    "languages": [
      {
        "id": "goboscript",
        "aliases": [
          "goboscript",
          "GoboScript"
        ],
        "extensions": [
          ".gs"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "goboscript",
        "scopeName": "source.goboscript",
        "path": "./syntaxes/goboscript.tmLanguage.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "goboscript.sb3Preview",
        "displayName": "goboscript preview",
        "selector": [
          {
            "filenamePattern": "*.sb3"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.138.0"
  }
}
