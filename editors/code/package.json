{
  "name": "goboscript",
  "displayName": "goboscript",
  "version": "2.0.0",
  "description": "goboscript language support for Visual Studio Code.",
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "keywords": [
    "goboscript"
  ],
  "homepage": "https://github.com/aspizu/goboscript",
  "license": "MIT",
  "author": {
    "name": "Priyanshu Dangare",
    "email": "hi@aspiz.uk",
    "url": "https://aspiz.uk"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aspizu/goboscript.git"
  },
  "publisher": "aspizu",
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "node esbuild.mts",
    "watch": "node esbuild.mts --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/preview/webview/tsconfig.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "package": "pnpm run compile && vsce package --no-dependencies -o goboscript.vsix"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "@turbowarp/scaffolding": "0.4.0",
    "lucide-preact": "^1.49.0",
    "neverthrow": "^8.2.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@turbowarp/types": "0.0.15",
    "@types/node": "^24.19.0",
    "@types/vscode": "^1.138.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "esbuild-plugin-tailwindcss": "^2.2.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3"
  },
  "contributes": {
    "languages": [
      {
        "id": "goboscript",
        "aliases": [
          "goboscript",
          "GoboScript"
        ],
        "extensions": [
          ".gs"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "goboscript",
        "scopeName": "source.goboscript",
        "path": "./syntaxes/goboscript.tmLanguage.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "goboscript.sb3Preview",
        "displayName": "goboscript preview",
        "selector": [
          {
            "filenamePattern": "*.sb3"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.138.0"
  }
}
