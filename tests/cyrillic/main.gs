costumes "blank.svg";

struct Точка {
    икс,
    игрек,
}

enum Направление {
    Север,
    Юг,
}

list Точка точки;

proc посчитать слагаемое1, слагаемое2 {
    сумма = $слагаемое1 + $слагаемое2;
}

proc запомнить_точку значение1, значение2 {
    Точка т = Точка { икс: $значение1, игрек: $значение2 };
    add т to точки;
    есть = $значение2 in точки.игрек;
}

proc выбрать_направление {
    курс = Направление.Север;
}

proc составить_подпись {
    local подсказка = "местная";
    подпись = подсказка & ": " & сумма;
}

onflag {
    посчитать 2, 3;
    say "Сумма: " & сумма;

    запомнить_точку 2, 3;
    say "икс: " & т.икс & ", игрек: " & т.игрек;
    say "есть в списке: " & есть;

    выбрать_направление;
    say "курс: " & курс & ", " & Направление.Юг;

    составить_подпись;
    say подпись;
}
