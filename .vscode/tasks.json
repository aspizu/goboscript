{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Server",
            "group": "build",
            "type": "shell",
            "command": "cargo build --package goboscript",
            "problemMatcher": "$rustc"
        },
        {
            "label": "Build Server (Release)",
            "group": "build",
            "type": "shell",
            "command": "cargo build --release --package goboscript",
            "problemMatcher": "$rustc"
        }
    ]
}
